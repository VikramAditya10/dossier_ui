{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dossier-ui/react": ["packages/react/src/index.ts"],
      "@dossier-ui/react/styles.css": ["packages/react/src/styles.css"],
      "@dossier-ui/tokens": ["packages/tokens/src/index.ts"],
      "@dossier-ui/icons": ["packages/icons/src/index.tsx"]
    },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["apps", "packages", "examples", "tests", ".storybook", "*.ts"]
}
