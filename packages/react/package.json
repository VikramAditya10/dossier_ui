{
  "name": "@vikramaditya1010/react",
  "version": "0.1.1",
  "description": "A React and CSS component framework for dense, monospace-first technical interfaces",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "dist/styles.css"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "monospace",
    "technical-ui",
    "data-table",
    "dossier-ui"
  ],
  "author": "Dossier UI Contributors",
  "license": "MIT",
  "homepage": "https://github.com/dossier-ui/dossier-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dossier-ui/dossier-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/dossier-ui/dossier-ui/issues"
  }
}
